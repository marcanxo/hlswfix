/*
 * Every text hlswfix shows, in every language HLSW itself speaks.
 *
 * One block per language, filed under the primary language id with no
 * sublanguage. HLSW records a full language id in
 * HKCU\Software\HLSW\Settings\Language, 1031 for German and 9 for English,
 * but only its primary half tells the languages apart, and that is the half
 * both sides use here. See src/text.h for how one is chosen and why HLSW's own
 * setting decides rather than the Windows one.
 *
 * English comes first and is the fallback for anything a translation has not
 * caught up with, so a missing line is missing and never empty.
 *
 * This file is UTF-8 and build.cmd passes windres -c 65001, which is what lets
 * Cyrillic, Chinese and Turkish stand here as themselves instead of as escapes
 * nobody can read or check.
 *
 * Three rules when adding or changing a language. Keep %s and %lu exactly
 * where they are and as many as the English line has, because the caller fills
 * them in that order. Keep \r\n and \n as they are, they are the line breaks
 * the dialogs rely on. And keep the texts short: these are dialogs, not
 * documentation. What needs explaining at length is explained in hlswfix.ini
 * and the README.
 */

#include "text.h"

#ifndef BUILD_DLL

/* ------------------------------------------------------------- English */
LANGUAGE 0x09, 0x00
STRINGTABLE
{
    STR_WINDOWS_ERROR       "Windows error %lu."
    STR_START_FAILED        "HLSW could not be started."
    STR_NO_HLSW             "HLSW was not found next to this program.\r\n\r\nhlswfix.exe, hlswfix.dll and hlswfix.ini belong in the folder HLSW is installed in, the one that has hlsw.exe in it."
    STR_LAUNCHER_IS_HLSW    "hlsw.exe is this launcher, and hlsw-real.exe is missing.\r\n\r\nAn HLSW update has most likely overwritten the launcher. Run install.ps1 again to put things back, or reinstall HLSW and then run it."
    STR_INJECT_FAILED       "hlswfix.dll could not be loaded into HLSW.\r\n\r\nHLSW starts anyway, but servers will show as timed out."

    STR_UPDATE_AVAILABLE    "hlswfix %s is available"
    STR_UPDATE_RUNNING      "This HLSW is running hlswfix %s."
    STR_UPDATE_WHAT_INSTALL "Installing downloads that release, checks it against the checksum published with it, and replaces two files. HLSW can stay open; the new version takes over the next time it starts. Your hlswfix.ini is left exactly as it is."
    STR_UPDATE_PAGE_ONLY    "That release cannot be installed from here, so it has to be downloaded from the page."
    STR_UPDATE_PRIVACY      "This check runs once when HLSW starts, asks GitHub for one file, and sends nothing about you or this machine. Put update_check = 0 in hlswfix.ini to switch it off."
    STR_BTN_INSTALL         "Install it now\nDownloads it and puts it in place. HLSW keeps running."
    STR_BTN_PAGE            "Open the release page\nSee what changed and download it yourself."
    STR_BTN_LATER           "Not now"

    STR_DOWNLOAD_FAILED     "The update could not be downloaded"
    STR_DOWNLOAD_FAILED_WHY "Either the download did not finish, or what arrived did not match the checksum published with the release. Nothing on this machine was changed.\n\nThe release page has the same archive to download by hand."
    STR_UNPACK_FAILED       "The update could not be unpacked"
    STR_UNPACK_FAILED_WHY   "The archive arrived complete and matched its published checksum, but the two files this installs are not in it in the form it expects. Nothing on this machine was changed.\n\nThe release page has the archive to install by hand."
    STR_INSTALL_FAILED      "The update could not be installed"
    STR_INSTALL_FAILED_DLL  "hlswfix.dll could not be replaced. Nothing was changed. The most likely reason is that the HLSW folder is not writable by this account."
    STR_INSTALL_FAILED_EXE  "The launcher could not be replaced, so hlswfix.dll was put back as it was and nothing has changed. The most likely reason is that the HLSW folder is not writable by this account."
    STR_INSTALLED           "Update installed"
    STR_INSTALLED_WHY       "Close HLSW and start it again to run the new version. Nothing else is needed, and hlswfix.ini was left exactly as it was."
}

/* -------------------------------------------------------------- German */
LANGUAGE 0x07, 0x00
STRINGTABLE
{
    STR_WINDOWS_ERROR       "Windows-Fehler %lu."
    STR_START_FAILED        "HLSW konnte nicht gestartet werden."
    STR_NO_HLSW             "Neben diesem Programm wurde kein HLSW gefunden.\r\n\r\nhlswfix.exe, hlswfix.dll und hlswfix.ini gehören in den Ordner, in dem HLSW installiert ist, also dorthin, wo hlsw.exe liegt."
    STR_LAUNCHER_IS_HLSW    "hlsw.exe ist dieser Starter, und hlsw-real.exe fehlt.\r\n\r\nWahrscheinlich hat ein HLSW-Update den Starter überschrieben. Starte install.ps1 erneut, oder installiere HLSW neu und danach install.ps1."
    STR_INJECT_FAILED       "hlswfix.dll konnte nicht in HLSW geladen werden.\r\n\r\nHLSW startet trotzdem, aber die Server werden als Zeitüberschreitung angezeigt."

    STR_UPDATE_AVAILABLE    "hlswfix %s ist verfügbar"
    STR_UPDATE_RUNNING      "Dieses HLSW läuft mit hlswfix %s."
    STR_UPDATE_WHAT_INSTALL "Installieren lädt diese Version herunter, prüft sie gegen die veröffentlichte Prüfsumme und ersetzt zwei Dateien. HLSW darf offen bleiben, die neue Fassung übernimmt beim nächsten Start. Deine hlswfix.ini bleibt unangetastet."
    STR_UPDATE_PAGE_ONLY    "Diese Version lässt sich von hier aus nicht installieren, sie muss von der Seite geladen werden."
    STR_UPDATE_PRIVACY      "Diese Prüfung läuft einmal beim Start von HLSW, fragt GitHub nach einer Datei und sendet nichts über dich oder diesen Rechner. Mit update_check = 0 in hlswfix.ini ist sie aus."
    STR_BTN_INSTALL         "Jetzt installieren\nLädt sie herunter und setzt sie ein. HLSW läuft weiter."
    STR_BTN_PAGE            "Release-Seite öffnen\nAnsehen, was sich geändert hat, und selbst herunterladen."
    STR_BTN_LATER           "Später"

    STR_DOWNLOAD_FAILED     "Das Update konnte nicht geladen werden"
    STR_DOWNLOAD_FAILED_WHY "Entweder wurde der Download nicht fertig, oder das Angekommene passte nicht zur veröffentlichten Prüfsumme. Auf diesem Rechner wurde nichts geändert.\n\nAuf der Release-Seite liegt dasselbe Archiv zum Laden von Hand."
    STR_UNPACK_FAILED       "Das Update konnte nicht entpackt werden"
    STR_UNPACK_FAILED_WHY   "Das Archiv kam vollständig an und passte zu seiner veröffentlichten Prüfsumme, aber die beiden Dateien liegen darin nicht in der erwarteten Form. Auf diesem Rechner wurde nichts geändert.\n\nAuf der Release-Seite liegt das Archiv zum Installieren von Hand."
    STR_INSTALL_FAILED      "Das Update konnte nicht installiert werden"
    STR_INSTALL_FAILED_DLL  "hlswfix.dll konnte nicht ersetzt werden. Es wurde nichts geändert. Am wahrscheinlichsten ist, dass dieses Konto im HLSW-Ordner nicht schreiben darf."
    STR_INSTALL_FAILED_EXE  "Der Starter konnte nicht ersetzt werden, deshalb wurde hlswfix.dll zurückgesetzt und es hat sich nichts geändert. Am wahrscheinlichsten ist, dass dieses Konto im HLSW-Ordner nicht schreiben darf."
    STR_INSTALLED           "Update installiert"
    STR_INSTALLED_WHY       "Schließe HLSW und starte es neu, damit die neue Fassung läuft. Mehr ist nicht nötig, und hlswfix.ini blieb genau so, wie sie war."
}

