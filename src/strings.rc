    STR_BTN_LATER           "Не сейчас"

    STR_DOWNLOAD_FAILED     "Не удалось скачать обновление"
    STR_DOWNLOAD_FAILED_WHY "Либо загрузка не завершилась, либо полученное не совпало с контрольной суммой, опубликованной вместе с выпуском. На этом компьютере ничего не изменилось.\n\nТот же архив можно скачать вручную со страницы выпуска."
    STR_UNPACK_FAILED       "Не удалось распаковать обновление"
    STR_UNPACK_FAILED_WHY   "Архив пришёл целиком и совпал с опубликованной контрольной суммой, но два устанавливаемых файла лежат в нём не в том виде, который ожидается. На этом компьютере ничего не изменилось.\n\nАрхив можно установить вручную со страницы выпуска."
    STR_INSTALL_FAILED      "Не удалось установить обновление"
    STR_INSTALL_FAILED_DLL  "Не удалось заменить hlswfix.dll. Ничего не изменилось. Вероятнее всего, у этой учётной записи нет права записи в папку HLSW."
    STR_INSTALL_FAILED_EXE  "Не удалось заменить запускающий файл, поэтому hlswfix.dll возвращён на место и ничего не изменилось. Вероятнее всего, у этой учётной записи нет права записи в папку HLSW."
    STR_INSTALLED           "Обновление установлено"
    STR_INSTALLED_WHY       "Закройте HLSW и запустите его снова, чтобы работала новая версия. Больше ничего не нужно, а hlswfix.ini остался ровно таким, каким был."
}

/* -------------------------------------------------------------- Slovak */
LANGUAGE 0x1B, 0x00
STRINGTABLE
{
    STR_WINDOWS_ERROR       "Chyba Windows %lu."
    STR_START_FAILED        "HLSW sa nepodarilo spustiť."
    STR_NO_HLSW             "Vedľa tohto programu sa nenašiel žiadny HLSW.\r\n\r\nSúbory hlswfix.exe, hlswfix.dll a hlswfix.ini patria do priečinka, kde je HLSW nainštalovaný, teda tam, kde je hlsw.exe."
    STR_LAUNCHER_IS_HLSW    "hlsw.exe je tento spúšťač a hlsw-real.exe chýba.\r\n\r\nSpúšťač zrejme prepísala aktualizácia HLSW. Spustite install.ps1 znova, alebo HLSW preinštalujte a potom ho spustite."
    STR_INJECT_FAILED       "Súbor hlswfix.dll sa nepodarilo načítať do HLSW.\r\n\r\nHLSW sa aj tak spustí, ale servery sa budú zobrazovať ako nedostupné."

    STR_UPDATE_AVAILABLE    "hlswfix %s je k dispozícii"
    STR_UPDATE_RUNNING      "Tento HLSW beží s hlswfix %s."
    STR_UPDATE_WHAT_INSTALL "Inštalácia stiahne toto vydanie, overí ho oproti zverejnenému kontrolnému súčtu a nahradí dva súbory. HLSW môže zostať otvorený; nová verzia sa uplatní pri ďalšom spustení. Váš hlswfix.ini zostane nedotknutý."
    STR_UPDATE_PAGE_ONLY    "Toto vydanie sa odtiaľto nedá nainštalovať, treba ho stiahnuť zo stránky."
    STR_UPDATE_PRIVACY      "Táto kontrola prebehne raz pri spustení HLSW, vyžiada si od GitHubu jeden súbor a neodosiela nič o vás ani o tomto počítači. Vypnete ju riadkom update_check = 0 v hlswfix.ini."
    STR_BTN_INSTALL         "Nainštalovať teraz\nStiahne ho a nasadí. HLSW beží ďalej."
    STR_BTN_PAGE            "Otvoriť stránku vydania\nPozrieť sa, čo sa zmenilo, a stiahnuť ručne."
    STR_BTN_LATER           "Teraz nie"

    STR_DOWNLOAD_FAILED     "Aktualizáciu sa nepodarilo stiahnuť"
    STR_DOWNLOAD_FAILED_WHY "Buď sa sťahovanie nedokončilo, alebo to, čo prišlo, nezodpovedá kontrolnému súčtu zverejnenému s vydaním. Na tomto počítači sa nič nezmenilo.\n\nRovnaký archív je na stiahnutie ručne na stránke vydania."
    STR_UNPACK_FAILED       "Aktualizáciu sa nepodarilo rozbaliť"
    STR_UNPACK_FAILED_WHY   "Archív prišiel celý a zodpovedá zverejnenému kontrolnému súčtu, ale dva inštalované súbory v ňom nie sú v očakávanej podobe. Na tomto počítači sa nič nezmenilo.\n\nArchív sa dá nainštalovať ručne zo stránky vydania."
    STR_INSTALL_FAILED      "Aktualizáciu sa nepodarilo nainštalovať"
    STR_INSTALL_FAILED_DLL  "Súbor hlswfix.dll sa nepodarilo nahradiť. Nič sa nezmenilo. Najpravdepodobnejším dôvodom je, že tento účet nemá právo zápisu do priečinka HLSW."
    STR_INSTALL_FAILED_EXE  "Spúšťač sa nepodarilo nahradiť, preto bol hlswfix.dll vrátený späť a nič sa nezmenilo. Najpravdepodobnejším dôvodom je, že tento účet nemá právo zápisu do priečinka HLSW."
    STR_INSTALLED           "Aktualizácia nainštalovaná"
    STR_INSTALLED_WHY       "Zavrite HLSW a spustite ho znova, aby bežala nová verzia. Nič iné netreba a hlswfix.ini zostal presne taký, aký bol."
}

/* ------------------------------------------------------------- Swedish */
LANGUAGE 0x1D, 0x00
STRINGTABLE
{
    STR_WINDOWS_ERROR       "Windows-fel %lu."
    STR_START_FAILED        "HLSW kunde inte startas."
    STR_NO_HLSW             "Det hittades inget HLSW bredvid det här programmet.\r\n\r\nhlswfix.exe, hlswfix.dll och hlswfix.ini hör hemma i mappen där HLSW är installerat, alltså där hlsw.exe ligger."
    STR_LAUNCHER_IS_HLSW    "hlsw.exe är den här startaren, och hlsw-real.exe saknas.\r\n\r\nEn HLSW-uppdatering har med största sannolikhet skrivit över startaren. Kör install.ps1 igen, eller installera om HLSW och kör den sedan."
    STR_INJECT_FAILED       "hlswfix.dll kunde inte läsas in i HLSW.\r\n\r\nHLSW startar ändå, men servrarna visas som tidsgräns överskriden."

    STR_UPDATE_AVAILABLE    "hlswfix %s finns tillgänglig"
    STR_UPDATE_RUNNING      "Det här HLSW kör med hlswfix %s."
    STR_UPDATE_WHAT_INSTALL "Installation hämtar den utgåvan, kontrollerar den mot den publicerade kontrollsumman och ersätter två filer. HLSW kan stå öppet; den nya versionen tar över nästa gång det startas. Din hlswfix.ini lämnas orörd."
    STR_UPDATE_PAGE_ONLY    "Den utgåvan går inte att installera härifrån utan måste hämtas från sidan."
    STR_UPDATE_PRIVACY      "Den här kontrollen körs en gång när HLSW startar, ber GitHub om en fil och skickar ingenting om dig eller den här datorn. Skriv update_check = 0 i hlswfix.ini för att stänga av den."
    STR_BTN_INSTALL         "Installera nu\nHämtar den och sätter den på plats. HLSW fortsätter att köra."
    STR_BTN_PAGE            "Öppna utgåvans sida\nSe vad som ändrats och hämta själv."
    STR_BTN_LATER           "Inte nu"

    STR_DOWNLOAD_FAILED     "Uppdateringen kunde inte hämtas"
    STR_DOWNLOAD_FAILED_WHY "Antingen blev hämtningen inte klar, eller så stämde det som kom fram inte med kontrollsumman som publicerats med utgåvan. Ingenting på den här datorn ändrades.\n\nSamma arkiv finns att hämta för hand på utgåvans sida."
    STR_UNPACK_FAILED       "Uppdateringen kunde inte packas upp"
    STR_UNPACK_FAILED_WHY   "Arkivet kom fram komplett och stämmer med sin publicerade kontrollsumma, men de två filer som installeras ligger inte i det i väntad form. Ingenting på den här datorn ändrades.\n\nArkivet finns att installera för hand på utgåvans sida."
    STR_INSTALL_FAILED      "Uppdateringen kunde inte installeras"
    STR_INSTALL_FAILED_DLL  "hlswfix.dll kunde inte ersättas. Ingenting ändrades. Den troligaste orsaken är att det här kontot inte får skriva i HLSW-mappen."
    STR_INSTALL_FAILED_EXE  "Startaren kunde inte ersättas, så hlswfix.dll sattes tillbaka och ingenting har ändrats. Den troligaste orsaken är att det här kontot inte får skriva i HLSW-mappen."
    STR_INSTALLED           "Uppdateringen installerad"
    STR_INSTALLED_WHY       "Stäng HLSW och starta det igen för att köra den nya versionen. Mer behövs inte, och hlswfix.ini lämnades exakt som den var."
}

