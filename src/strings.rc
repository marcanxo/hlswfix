LANGUAGE 0x1F, 0x00
STRINGTABLE
{
    STR_WINDOWS_ERROR       "Windows hatası %lu."
    STR_START_FAILED        "HLSW başlatılamadı."
    STR_NO_HLSW             "Bu programın yanında HLSW bulunamadı.\r\n\r\nhlswfix.exe, hlswfix.dll ve hlswfix.ini dosyaları HLSW'nin kurulu olduğu klasöre, yani hlsw.exe'nin bulunduğu yere aittir."
    STR_LAUNCHER_IS_HLSW    "hlsw.exe bu başlatıcının kendisi ve hlsw-real.exe eksik.\r\n\r\nBüyük olasılıkla bir HLSW güncellemesi başlatıcının üzerine yazdı. install.ps1 dosyasını yeniden çalıştırın veya HLSW'yi yeniden kurup ardından çalıştırın."
    STR_INJECT_FAILED       "hlswfix.dll, HLSW içine yüklenemedi.\r\n\r\nHLSW yine de açılır, ancak sunucular zaman aşımı olarak görünür."

    STR_UPDATE_AVAILABLE    "hlswfix %s kullanılabilir"
    STR_UPDATE_RUNNING      "Bu HLSW, hlswfix %s ile çalışıyor."
    STR_UPDATE_WHAT_INSTALL "Kurmak, o sürümü indirir, birlikte yayımlanan sağlama toplamıyla karşılaştırır ve iki dosyayı değiştirir. HLSW açık kalabilir; yeni sürüm bir sonraki açılışta devreye girer. hlswfix.ini dosyanıza dokunulmaz."
    STR_UPDATE_PAGE_ONLY    "O sürüm buradan kurulamaz, sayfadan indirilmesi gerekir."
    STR_UPDATE_PRIVACY      "Bu denetim HLSW açılırken bir kez çalışır, GitHub'dan tek bir dosya ister ve sizinle ya da bu bilgisayarla ilgili hiçbir şey göndermez. Kapatmak için hlswfix.ini içine update_check = 0 yazın."
    STR_BTN_INSTALL         "Şimdi kur\nİndirir ve yerine koyar. HLSW çalışmaya devam eder."
    STR_BTN_PAGE            "Sürüm sayfasını aç\nNelerin değiştiğini görün ve kendiniz indirin."
    STR_BTN_LATER           "Şimdi değil"

    STR_DOWNLOAD_FAILED     "Güncelleme indirilemedi"
    STR_DOWNLOAD_FAILED_WHY "Ya indirme tamamlanmadı ya da gelen içerik sürümle birlikte yayımlanan sağlama toplamıyla uyuşmadı. Bu bilgisayarda hiçbir şey değiştirilmedi.\n\nAynı arşiv sürüm sayfasından elle indirilebilir."
    STR_UNPACK_FAILED       "Güncelleme açılamadı"
    STR_UNPACK_FAILED_WHY   "Arşiv eksiksiz ulaştı ve yayımlanan sağlama toplamıyla uyuştu, ancak kurulacak iki dosya arşivde beklenen biçimde değil. Bu bilgisayarda hiçbir şey değiştirilmedi.\n\nArşiv sürüm sayfasından elle kurulabilir."
    STR_INSTALL_FAILED      "Güncelleme kurulamadı"
    STR_INSTALL_FAILED_DLL  "hlswfix.dll değiştirilemedi. Hiçbir şey değiştirilmedi. En olası neden, bu hesabın HLSW klasörüne yazma yetkisinin olmamasıdır."
    STR_INSTALL_FAILED_EXE  "Başlatıcı değiştirilemedi, bu yüzden hlswfix.dll eski haline döndürüldü ve hiçbir şey değişmedi. En olası neden, bu hesabın HLSW klasörüne yazma yetkisinin olmamasıdır."
    STR_INSTALLED           "Güncelleme kuruldu"
    STR_INSTALLED_WHY       "Yeni sürümün çalışması için HLSW'yi kapatıp yeniden açın. Başka bir şey gerekmez ve hlswfix.ini tam olarak olduğu gibi kaldı."
}

